# Supabase public configuration (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Legacy fallback while migrating projects that still expose an anon key.
# Prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY for new deployments.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Reserved for explicitly administrative operations such as the
# temporary Storage upload flow. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional durable rate limiting for login, invites and uploads.
# When set, both values are server-only and use Upstash Redis REST.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
