{
  "name": "selma-bordados",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "test:auth": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/lib/auth/session.test.mjs",
    "test:rbac": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/lib/auth/rbac.test.mjs",
    "test:authorization": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/lib/auth/authorization-enforcement.test.mjs",
    "test:security": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/lib/security/lot3-security.test.mjs",
    "test:date": "node --test src/lib/business-date.test.mjs",
    "test:finance": "node --test src/lib/domain/finance/calculations.test.mjs",
    "test:orders": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/lib/schemas/pedido.test.mjs",
    "test:crm": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/lib/domain/crm.test.mjs src/lib/domain/crm-security.test.mjs",
    "test:commercial": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/lib/domain/commercial-intelligence.test.mjs src/lib/domain/commercial-intelligence-security.test.mjs",
    "test:quotes": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/lib/domain/quotes/pricing.test.mjs src/lib/domain/quotes/security.test.mjs",
    "test:operations": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/lib/domain/operations.test.mjs src/lib/domain/operations-security.test.mjs",
    "test:integration": "node --test src/lib/integration/deskcomm-commercial-bridge.test.mjs src/lib/integration/single-application.test.mjs",
    "test": "npm run test:auth && npm run test:rbac && npm run test:authorization && npm run test:security && npm run test:date && npm run test:finance && npm run test:orders && npm run test:crm && npm run test:commercial && npm run test:quotes && npm run test:operations && npm run test:integration",
    "audit": "npm audit --omit=dev",
    "verify": "npm run check && npm run test && npm run build && npm run audit"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@hookform/resolvers": "^5.4.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.3.0",
    "lucide-react": "^1.16.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "6.3.289",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.76.1",
    "react-to-print": "^3.3.0",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
